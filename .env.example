# Strava OAuth credentials for this deployment's dedicated API app.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Current access token used by the API. Update these token variables together.
STRAVA_ACCESS_TOKEN=
# Unix timestamp from Strava's expires_at response field.
STRAVA_ACCESS_TOKEN_EXPIRES_AT=
# Current refresh token, used when manually renewing the access token.
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# Random value used for the Strava webhook verification handshake.
STRAVA_VERIFY_TOKEN=

# Gemini API key from https://aistudio.google.com/app/apikey. Keep server-side.
GEMINI_API_KEY=

# Gemini model identifier. Change only to a model available to your API key.
GEMINI_MODEL=gemini-2.5-flash

# Maximum final description length, including DESCRIPTION_APPEND_URL (20-1000).
DESCRIPTION_MAX_CHARS=160

# Writing style and constraints sent to Gemini with each activity's metrics.
# Keep this to instructions; do not put credentials or personal data here.
DESCRIPTION_INSTRUCTIONS=Write a vivid, concise cycling description. Use only the supplied facts and avoid inventing route details.

# Optional URL appended to each description. Leave blank to disable.
DESCRIPTION_APPEND_URL=

# By default, activities that already have a description are left unchanged.
OVERWRITE_EXISTING_DESCRIPTIONS=false